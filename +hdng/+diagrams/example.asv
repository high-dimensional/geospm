function example()

    %{

        yellow 
        hsv(48, 80%, 100%)
        hsl(48, 100%, 60%)

        dark_yellow
        hsl(48, 100%, 42%)

        blue
        hsv(196, 43.58%, 89.5%)
        hsl(196, 65%, 70%)

        dark_blue
        hsl(196, 100%, 39%)

        red
        hsv(13, 52.89%, 91.09%)
        hsl(13, 73%, 67%)
        
        dark_red
        hsl(13, 90%, 40%)

        line_dark_grey
        hsl(0, 0%, 60%)

        
    %}
    
    colours = struct();
    colours.yellow = '#FFD631'; %'hsl(48, 100%, 60%)';
    colours.dark_yellow = '#D6AB00'; %'hsl(48, 100%, 42%)';
    colours.blue = '#80C9E4'; %'hsl(196, 65%, 70%)';
    colours.dark_blue = '#0094C9'; %'hsl(196, 100%, 39%)';
    colours.red = '#E9896E'; %'hsl(13, 73%, 67%)';
    colours.dark_red = '#C3320A'; %'hsl(13, 90%, 40%)';
    colours.line_light_grey = '#DDDDDD'; %'hsl(0, 0%, 87%)';
    colours.line_dark_grey = '#999999'; %'hsl(0, 0%, 60%)';

    variable_scale = hdng.diagrams.ExplicitOrdinalScale();
    variable_scale.order_index_map = {
        'completion_time_1', 2;
        'reaction_time', 2; 
        'ndiox_pollution_2010', 3;
        'nox_pollution_2010', 3;
        'pm2_5_2010', 3; 
        'ndiox_pollution_2010_x_reaction_time', 1;
        'nox_pollution_2010_x_reaction_time', 1;
        'pm2_5_2010_x_reaction_time', 1;
        'ndiox_pollution_2010_x_completion_time_1', 1;
        'nox_pollution_2010_x_completion_time_1', 1;
        'pm2_5_2010_x_completion_time_1', 1
    };
    
    variable_colour_scale = hdng.diagrams.ExplicitOrdinalScale();
    variable_colour_scale.order_index_map = {
        'completion_time_1', colours.blue;
        'reaction_time', colours.blue; 
        'ndiox_pollution_2010', colours.red;
        'nox_pollution_2010', colours.red;
        'pm2_5_2010', colours.red; 
        'ndiox_pollution_2010_x_reaction_time', colours.yellow;
        'nox_pollution_2010_x_reaction_time', colours.yellow;
        'pm2_5_2010_x_reaction_time', colours.yellow;
        'ndiox_pollution_2010_x_completion_time_1', colours.yellow;
        'nox_pollution_2010_x_completion_time_1', colours.yellow;
        'pm2_5_2010_x_completion_time_1', colours.yellow
    };
    
    variable_dark_colour_scale = hdng.diagrams.ExplicitOrdinalScale();
    variable_dark_colour_scale.order_index_map = {
        'completion_time_1', colours.dark_blue;
        'reaction_time', colours.dark_blue; 
        'ndiox_pollution_2010', colours.dark_red;
        'nox_pollution_2010', colours.dark_red;
        'pm2_5_2010', colours.dark_red; 
        'ndiox_pollution_2010_x_reaction_time', colours.dark_yellow;
        'nox_pollution_2010_x_reaction_time', colours.dark_yellow;
        'pm2_5_2010_x_reaction_time', colours.dark_yellow;
        'ndiox_pollution_2010_x_completion_time_1', colours.dark_yellow;
        'nox_pollution_2010_x_completion_time_1', colours.dark_yellow;
        'pm2_5_2010_x_completion_time_1', colours.dark_yellow
    };

    
    function result = test_interaction_signs(interaction, effect1, effect2)
        result = struct();
        result.symbol_category = 0;

        if sign(interaction) ~= sign(effect1) * sign(effect2)
            return;
        end

        if sign(interaction) > 0
            result.symbol_category = (sign(effect1) + 1) / 2 + 1;
        else
            result.symbol_category = 3;
        end
    end

    function result = compute_polygon_offset(data_scope, base, parent, siblings)


        result = struct();
        result.polygon_offset = 0;
        
        previous = siblings.inward(data_scope, base);

        if ~isempty(previous)
            previous = previous{1};
            result.polygon_offset = previous.attributes.polygon_offset + ...
                numel(previous.children_by_data_level.polygon);
        end
    end

    data_module = hdng.diagrams.DataModule();
    
    data_module.add_definitions( ...
        hdng.diagrams.DataLevel( ...
            'identifier', 'region', ...
            'generator_list', { ...
                %hdng.diagrams.generators.Match('fields', {'study'}, 'match_values', hdng.one_struct('study', {'leeds'})), ...
                hdng.diagrams.generators.Partition('fields', {'study'})
            }, ...
            'children', { ...
                hdng.diagrams.DataLevel( ...
                    'identifier', 'variant', ...
                    'generator_list', { ...
                        %hdng.diagrams.generators.Match('fields', {'interaction'}, 'match_values', hdng.one_struct('interaction', {'ndiox_pollution_2010_x_reaction_time'})), ...
                        hdng.diagrams.generators.Partition('fields', {'interaction'})
                    }, ...
                    'assignments', {...
                       hdng.diagrams.AttributeAssignment(...
                           {'polygon_offset'}, {...
                                hdng.diagrams.transforms.DelegateCall('attributes', @compute_polygon_offset) ...
                           } ...
                       ) ...
                    }, ...
                    'children', { ...
                        hdng.diagrams.DataLevel( ...
                            'identifier', 'polygon', ...
                            'generator_list', { ...
                                %hdng.diagrams.generators.Match('fields', {'polygon'}, 'match_values', hdng.one_struct('polygon', 1)), ...
                                hdng.diagrams.generators.Partition('fields', {'polygon'})
                            }, ...
                            'assignments', {...
                               hdng.diagrams.AttributeAssignment(...
                                   {'symbol_category'}, {...
                                        hdng.diagrams.transforms.GatherNestedAttributes( ...
                                            hdng.diagrams.transforms.GatherNestedAttributes.create_specifier( ...
                                                'variable', {'category'} ...
                                            ), ...
                                            hdng.diagrams.transforms.GatherNestedAttributes.create_specifier( ...
                                                'variable_summary', {'median'} ...
                                            ) ...
                                        ), ...
                                        hdng.diagrams.transforms.Pivot('category', @(a) arrayfun(@(x) sprintf('value_%d', x), a, 'UniformOutput', false), {}, [], false), ...
                                        hdng.diagrams.transforms.Call('attributes', @test_interaction_signs, 'fields_ascending') ...
                                   } ... 
                               ) ...
                            }, ...
                            'children', { ...
                                hdng.diagrams.DataLevel(...
                                    'identifier', 'variable', ...
                                    'generator_list', { ...
                                        hdng.diagrams.generators.Match('fields', {'name'}, 'match_values', hdng.one_struct('name', variable_scale.ordered_values)), ...
                                        hdng.diagrams.generators.Augment( ...
                                            hdng.diagrams.generators.Augment.map('name', variable_scale, 'category') ...
                                        ), ...
                                        hdng.diagrams.generators.Partition('fields', {'name', 'category'})
                                    }, ...
                                    'children', { ...
                                        hdng.diagrams.DataLevel(...
                                            'identifier', 'variable_summary', ...
                                            'generator_list', { ...
                                                hdng.diagrams.generators.Aggregate( ...
                                                    'attributes', ...
                                                    hdng.diagrams.generators.Aggregate.count('value'), ...
                                                    hdng.diagrams.generators.Aggregate.min('value'), ...
                                                    hdng.diagrams.generators.Aggregate.max('value'), ...
                                                    hdng.diagrams.generators.Aggregate.quantile('value', [0.25, 0.5, 0.75], {'q1', 'median', 'q3'}) ...
                                                ) ...   
                                            }, ...
                                            'children', { ...
                                        })
                                })
                        })
                })
        }) ...
    );
    

    variant_scale = hdng.diagrams.ImplicitOrdinalScale();
    variant_scale.ordered_values = {
        %'completion_time_1';
        %'reaction_time'; 
        %'ndiox_pollution_2010';
        %'nox_pollution_2010';
        %'pm2_5_2010'; 
        'ndiox_pollution_2010_x_reaction_time';
        'nox_pollution_2010_x_reaction_time';
        'pm2_5_2010_x_reaction_time';
        'ndiox_pollution_2010_x_completion_time_1';
        'nox_pollution_2010_x_completion_time_1';
        'pm2_5_2010_x_completion_time_1'
    };
    
    feature_module = hdng.diagrams.FeatureModule();
    
    %{
    function compute_variant_0_rule(~, context, ~, constants)

        context.self.values_by_identifier.stroke = 'black';
        context.self.values_by_identifier.stroke_width = '3';
        
        
        %origin = cell2mat(value_scale.apply({0}));
        origin = constants.value_scale{1};
        
        context.self.values_by_identifier.x1 = origin;
        context.self.values_by_identifier.x2 = origin;
        context.self.values_by_identifier.y1 = 0;
        context.self.values_by_identifier.y2 = context.parent.values_by_identifier.height;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'height', 'vertical_padding'};
    
    variant_0_rule_expr = hdng.diagrams.FeatureExpression(...
        {'x1', 'x2', 'y1', 'y2', 'stroke', 'stroke_width'}, ...
        @compute_variant_0_rule, ...
        deps, ...
        [], ...
        hdng.one_struct(...
            'value_scale', {...
                0 ...
            } ...
        ) ...
    );
    %}


    function compute_value_axis(~, context, ~, ~)

        context.self.values_by_identifier.offset = context.parent.values_by_identifier.height;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'height'};
    
    variant_value_axis_expr = hdng.diagrams.FeatureExpression(...
        {'offset'}, ...
        @compute_value_axis, ...
        deps...
    );


    function compute_variant_expr(~, context, ~, ~)
        
        variant_index = cell2mat(variant_scale.apply({context.self.data_scope.attributes.interaction})) - 1;
        
        context.self.values_by_identifier.polygon_height = context.self.values_by_identifier.height / 5;
        context.self.values_by_identifier.x = 0;
        context.self.values_by_identifier.y = ...
            (variant_index * (context.self.values_by_identifier.height + context.self.values_by_identifier.vertical_padding)) ...
            + context.self.values_by_identifier.vertical_padding / 2;
    end
    
    deps = struct();
    deps.self = {};
    
    variant_expr = hdng.diagrams.FeatureExpression(...
        {'polygon_height', 'x', 'y'}, ...
        @compute_variant_expr, ...
        deps ...
    );
    
    function compute_variant_box(~, context, ~, ~)
        
        context.self.values_by_identifier.fill = 'none';
        context.self.values_by_identifier.stroke = colours.line_light_grey;
        context.self.values_by_identifier.x1 = 0;
        context.self.values_by_identifier.x2 = context.parent.values_by_identifier.width;
        context.self.values_by_identifier.y1 = 0;
        context.self.values_by_identifier.y2 = context.parent.values_by_identifier.height;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'width', 'height', 'vertical_padding'};
    
    variant_box_expr = hdng.diagrams.FeatureExpression(...
        {'x1', 'x2', 'y1', 'y2', 'fill', 'stroke'}, ...
        @compute_variant_box, ...
        deps ...
    );



    function compute_polygon_expr(~, context, scaled_values, ~)

        %polygon_index = context.self.data_scope.attributes.polygon - 1;
        polygon_index = scaled_values.polygon_scale.polygon - 1;

        context.self.values_by_identifier.height = context.parent.values_by_identifier.polygon_height;
        context.self.values_by_identifier.width = context.parent.values_by_identifier.width;

        context.self.values_by_identifier.variable_height = (context.self.values_by_identifier.height - 20) / 3;
        context.self.values_by_identifier.x = 0;
        context.self.values_by_identifier.y = polygon_index * context.self.values_by_identifier.height;
        context.self.values_by_identifier.scaled_polygon_index = polygon_index;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'polygon_height', 'width'};
    
    polygon_expr = hdng.diagrams.FeatureExpression(...
        {'height', 'width', 'variable_height', 'x', 'y', 'scaled_polygon_index'}, ...
        @compute_polygon_expr, ...
        deps, ...
        hdng.one_struct(...
            'polygon_scale', {...
                'polygon' ...
            } ...
        ) ...
    );


    
    function compute_polygon_box(~, context, ~, ~)
        
        context.self.values_by_identifier.fill = 'none';
        context.self.values_by_identifier.stroke = colours.line_light_grey;
        context.self.values_by_identifier.x1 = 0;
        context.self.values_by_identifier.x2 = context.parent.values_by_identifier.width;
        context.self.values_by_identifier.y1 = 0;
        context.self.values_by_identifier.y2 = context.parent.values_by_identifier.height;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'width', 'height'};
    
    polygon_box_expr = hdng.diagrams.FeatureExpression(...
        {'x1', 'x2', 'y1', 'y2', 'stroke', 'fill'}, ...
        @compute_polygon_box, ...
        deps ...
    );

    function compute_polygon_circle(~, context, ~, ~)
        
        context.self.values_by_identifier.fill = 'none';
        context.self.values_by_identifier.stroke = 'black';
        context.self.values_by_identifier.cx = context.parent.values_by_identifier.width + context.parent.values_by_identifier.height / 4 + 10;
        context.self.values_by_identifier.cy = context.parent.values_by_identifier.height / 2;
        context.self.values_by_identifier.r = context.parent.values_by_identifier.height / 4;
        context.self.values_by_identifier.width = context.parent.values_by_identifier.height / 4;
        context.self.values_by_identifier.height = context.parent.values_by_identifier.height / 4;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'width', 'height'};
    
    polygon_circle_expr = hdng.diagrams.FeatureExpression(...
        {'cx', 'cy', 'r', 'stroke', 'fill', 'width', 'height'}, ...
        @compute_polygon_circle, ...
        deps ...
    );




    function compute_polygon_switch(~, context, ~, ~)
        
        context.self.values_by_identifier.choice = context.self.data_scope.attributes.symbol_category + 1;

        context.self.values_by_identifier.symbol_x = context.parent.values_by_identifier.width - 10 - context.parent.values_by_identifier.height / 4;
        context.self.values_by_identifier.symbol_y = context.parent.values_by_identifier.height / 8;
        context.self.values_by_identifier.symbol_width = context.parent.values_by_identifier.height / 4;
        context.self.values_by_identifier.symbol_height = context.parent.values_by_identifier.height / 4;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'width', 'height'};
    
    polygon_switch_expr = hdng.diagrams.FeatureExpression(...
        {'choice', 'symbol_x', 'symbol_y', 'symbol_width', 'symbol_height'}, ...
        @compute_polygon_switch, ...
        deps ...
    );

    function compute_polygon_symbol(~, context, ~, ~)
        
        context.self.values_by_identifier.stroke = 'black';
        context.self.values_by_identifier.stroke_width = '3';

        context.self.values_by_identifier.choice = context.parent.values_by_identifier.choice;

        context.self.values_by_identifier.x = context.parent.values_by_identifier.symbol_x;
        context.self.values_by_identifier.y = context.parent.values_by_identifier.symbol_y;
        context.self.values_by_identifier.width = context.parent.values_by_identifier.symbol_width;
        context.self.values_by_identifier.height = context.parent.values_by_identifier.symbol_height;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'choice', 'symbol_x', 'symbol_y', 'symbol_width', 'symbol_height'};
    
    polygon_symbol_expr = hdng.diagrams.FeatureExpression(...
        {'choice', 'x', 'y', 'width', 'height', 'stroke', 'stroke_width'}, ...
        @compute_polygon_symbol, ...
        deps ...
    );



    label_style = hdng.typesetting.Style();
    label_style.font_family = 'Barlow';
    label_style.font_size = 44;
    
    function compute_polygon_text(~, context, ~, ~)

        offset = context.grandparent.data_scope.attributes.polygon_offset;
        text = sprintf('%d', offset + context.parent.values_by_identifier.scaled_polygon_index + 1); %context.self.data_scope.attributes.polygon);

        line = hdng.typesetting.layout_text({text}, {label_style}, [], [], 'pixels');
        line_height = line.fragments(1).height;
        line_width = line.fragments(1).width;

        context.self.values_by_identifier.fill = 'black';
        %context.self.values_by_identifier.stroke = 'black';
        %context.self.values_by_identifier.style = sprintf('font-family: Barlow, sans-serif; font-size: %dpx;', label_style.font_size);
        context.self.values_by_identifier.class = 'polygon_label';

        context.self.values_by_identifier.text_x = context.parent.values_by_identifier.width + context.parent.values_by_identifier.height / 4 + 10 - line_width / 2.2;
        context.self.values_by_identifier.text_y = context.parent.values_by_identifier.height / 2 + line_height * 0.27;

        context.self.values_by_identifier.text_x_is_increment = false;
        context.self.values_by_identifier.text_y_is_increment = false;

        context.self.values_by_identifier.text = text;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'width', 'height', 'scaled_polygon_index'};
    deps.grandparent = {};
    
    polygon_text_expr = hdng.diagrams.FeatureExpression(...
        {'text_x', 'text_y', 'text_x_is_increment', 'text_y_is_increment', 'text', 'fill', 'style'}, ...
        @compute_polygon_text, ...
        deps ...
    );


    function compute_variable_expr(~, context, ~, ~)
        
        variable_index = cell2mat(variable_scale.apply({context.self.data_scope.attributes.name})) - 1;
        
        context.self.values_by_identifier.height = context.parent.values_by_identifier.variable_height;
        context.self.values_by_identifier.width = context.parent.values_by_identifier.width;

        context.self.values_by_identifier.x = 0;
        context.self.values_by_identifier.y = 10 + variable_index * context.self.values_by_identifier.height;
        
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'variable_height', 'width'};
    
    variable_expr = hdng.diagrams.FeatureExpression(...
        {'height', 'width', 'x', 'y'}, ...
        @compute_variable_expr, ...
        deps ...
    );

    function compute_variable_summary_expr(~, context, ~, ~)
        context.self.values_by_identifier.width = context.parent.values_by_identifier.width;
        context.self.values_by_identifier.height = context.parent.values_by_identifier.height;
    end

    deps = struct();
    deps.self = {};
    deps.parent = {'width', 'height'};
    
    variable_summary_expr = hdng.diagrams.FeatureExpression(...
        {'width', 'height', 'colour'}, ...
        @compute_variable_summary_expr, ...
        deps ...
    );

    function compute_variable_summary_box(~, context, scaled_values, ~)

        context.self.values_by_identifier.fill = variable_colour_scale.apply({context.self.data_scope.attributes.name});
        context.self.values_by_identifier.fill = context.self.values_by_identifier.fill{1};

        %{
        stats = context.self.data_scope.attributes;

        stats.q1     = cell2mat(value_scale.apply({stats.q1}));
        stats.q3     = cell2mat(value_scale.apply({stats.q3}));
        %}

        context.self.values_by_identifier.x1 = scaled_values.value_scale.q1;
        context.self.values_by_identifier.x2 = scaled_values.value_scale.q3;
        context.self.values_by_identifier.y1 = context.parent.values_by_identifier.height * 0.0;
        context.self.values_by_identifier.y2 = context.parent.values_by_identifier.height * 1.0;
    end

    deps = struct();
    deps.self = {};
    deps.parent = {'width', 'height'};
    
    variable_summary_box_expr = hdng.diagrams.FeatureExpression(...
        {'x1', 'x2', 'y1', 'y2', 'fill'}, ...
        @compute_variable_summary_box, ...
        deps, ...
        hdng.one_struct(...
            'value_scale', {...
                'q1', 'q3' ...
            } ...
        ) ...
    );


    function compute_variable_summary_line(~, context, scaled_values, ~)

        context.self.values_by_identifier.stroke = colours.line_dark_grey;
        context.self.values_by_identifier.stroke_width = '3';

        %{
        stats = context.self.data_scope.attributes;

        stats.min    = cell2mat(value_scale.apply({stats.value_min}));
        stats.max    = cell2mat(value_scale.apply({stats.value_max}));
        %}

        context.self.values_by_identifier.x1 = scaled_values.value_scale.value_min;
        context.self.values_by_identifier.x2 = scaled_values.value_scale.value_max;
        context.self.values_by_identifier.y1 = context.parent.values_by_identifier.height / 2;
        context.self.values_by_identifier.y2 = context.parent.values_by_identifier.height / 2;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'height'};
    
    variable_summary_line_expr = hdng.diagrams.FeatureExpression(...
        {'x1', 'x2', 'y1', 'y2', 'stroke', 'stroke_width'}, ...
        @compute_variable_summary_line, ...
        deps, ...
        hdng.one_struct(...
            'value_scale', {...
                'value_min', 'value_max' ...
            } ...
        ) ...
    );


    function compute_variable_summary_rule(~, context, scaled_values, ~)

        context.self.values_by_identifier.fill = variable_dark_colour_scale.apply({context.self.data_scope.attributes.name});
        context.self.values_by_identifier.fill = context.self.values_by_identifier.fill{1};

        %{
        stats = context.self.data_scope.attributes;
        stats.median = cell2mat(value_scale.apply({stats.median}));
        %}

        median = scaled_values.value_scale.median;

        context.self.values_by_identifier.x1 = median - 2.5;
        context.self.values_by_identifier.x2 = median + 2.5;
        context.self.values_by_identifier.y1 = context.parent.values_by_identifier.height * 0.0;
        context.self.values_by_identifier.y2 = context.parent.values_by_identifier.height * 1.0;
    end
    
    deps = struct();
    deps.self = {};
    deps.parent = {'height'};
    
    variable_summary_rule_expr = hdng.diagrams.FeatureExpression(...
        {'x1', 'x2', 'y1', 'y2', 'fill'}, ...
        @compute_variable_summary_rule, ...
        deps, ...
        hdng.one_struct(...
            'value_scale', {...
                'median' ...
            } ...
        ) ...
    );
    
    function render_ascending_symbol(feature, render_context, render_options, base, parents, siblings) %#ok<INUSD>
        x = feature.values_by_identifier.x;
        y = feature.values_by_identifier.y;
        width = feature.values_by_identifier.width;
        height = feature.values_by_identifier.height;
        
        render_options = hdng.utilities.struct_to_name_value_sequence(render_options);

        d = height / 4;

        render_context.renderer.render_line( ...
                x, x + width, y + height - d, y - d, render_context, render_options{:});

        render_context.renderer.render_line( ...
                x, x + width, y + height + d, y + d, render_context, render_options{:});
    end

    function render_descending_symbol(feature, render_context, render_options, base, parents, siblings) %#ok<INUSD>
        x = feature.values_by_identifier.x;
        y = feature.values_by_identifier.y;
        width = feature.values_by_identifier.width;
        height = feature.values_by_identifier.height;
        
        render_options = hdng.utilities.struct_to_name_value_sequence(render_options);

        d = height / 4;

        render_context.renderer.render_line( ...
                x, x + width, y - d, y + height - d, render_context, render_options{:});

        render_context.renderer.render_line( ...
                x, x + width, y + d, y + height + d, render_context, render_options{:});
    end

    function render_cross_symbol(feature, render_context, render_options, base, parents, siblings) %#ok<INUSD>
        x = feature.values_by_identifier.x;
        y = feature.values_by_identifier.y;
        width = feature.values_by_identifier.width;
        height = feature.values_by_identifier.height;

        render_options = hdng.utilities.struct_to_name_value_sequence(render_options);

        render_context.renderer.render_line( ...
                x, x + width, y, y + height, render_context, render_options{:});

        render_context.renderer.render_line( ...
                x, x + width, y + height, y, render_context, render_options{:});
    end

    axis_config = hdng.diagrams.configurations.AxisConfiguration();
    axis_config.baseline.show = false;

    axis_config.labels.style = label_style;
    axis_config.labels.show_min_label = true;
    axis_config.labels.show_max_label = true;

    axis_config.labels.style_class = 'tick_label';

    axis_config.rules.at = {0};
    axis_config.rules.label_style_class = 'rule_label';
    variant_value_axis_config = axis_config;

    style_definitions = '.polygon_label, .rule_label, .tick_label { font-family: Barlow, sans-serif; font-size: 44px; }';

    renderer = hdng.diagrams.rendering.svg.SVGRenderer();
    
    feature_module.add_definitions(...
        hdng.diagrams.FeatureDeclarator(...
            'identifier', 'region', ...
            'children', { ...
            }, ...
            'directives', ...
            {
                hdng.diagrams.ChangeRenderScope( ...
                    'type', 'file', ...
                    'name', 'boxplots_<study>.svg', ...
                    'style_definitions', style_definitions ...
                ) ...
            }, ...
            'scale_declarators', {...
                hdng.diagrams.ScaleDeclarator(...
                    'identifier', 'polygon_scale', ...
                    'ctor_name', 'hdng.diagrams.ImplicitOrdinalScale', ...
                    'ctor_arguments', hdng.one_struct(...
                        'squash', true, ...
                        'domain_is_numeric', true, ...
                        'ordered_values', num2cell(1:12) ...
                    ) ...
                ) ...
            } ...
        ), ...
        hdng.diagrams.FeatureDeclarator(...
            'identifier', 'variant', ...
            'children', { ...
                hdng.diagrams.features.BoxDeclarator( ...
                    'expression', variant_box_expr ...
                ), ...
                hdng.diagrams.features.AxisDeclarator( ...
                    'expression', variant_value_axis_expr, ...
                    'scale_identifier', 'value_scale', ...
                    'configuration', variant_value_axis_config ...
                ) ...
            }, ...
            'values_by_identifier', hdng.one_struct(...
                'width', 600, 'height', 600, 'vertical_padding', 20 ...
            ), ...
            'expression', variant_expr, ...
            'directives', {...
            }, ...
            'scale_declarators', {...
            } ...
        ), ...
        hdng.diagrams.FeatureDeclarator(...
            'identifier', 'polygon', ...
            'expression', polygon_expr, ...
            'children', { ...
                hdng.diagrams.features.BoxDeclarator( ...
                    'expression', polygon_box_expr ...
                ), ...
                hdng.diagrams.features.TextDeclarator( ...
                    'expression', polygon_text_expr ...
                ), ...
                hdng.diagrams.features.ShapeDeclarator( ...
                    'expression', polygon_circle_expr, ...
                    'children', { ...
                    }, ...
                    'values_by_identifier', hdng.one_struct(...
                        'shape', 'circle' ...
                    ) ...
                ), ...
                hdng.diagrams.features.SwitchDeclarator( ...
                    'expression', polygon_switch_expr, ...
                    'children', { ...
                        hdng.diagrams.features.GeometryDeclarator( ...
                            ...
                        ), ...
                        hdng.diagrams.features.CustomDeclarator( ...
                            'expression', polygon_symbol_expr, ...
                            'delegate', @render_ascending_symbol ...
                        ), ...
                        hdng.diagrams.features.CustomDeclarator( ...
                            'expression', polygon_symbol_expr, ...
                            'delegate', @render_descending_symbol ...
                        ), ...
                        hdng.diagrams.features.CustomDeclarator( ...
                            'expression', polygon_symbol_expr, ...
                            'delegate', @render_cross_symbol ...
                        ) ...
                    } ...
                )
            } ...
        ), ...
        hdng.diagrams.FeatureDeclarator(...
            'identifier', 'variable', ...
            'expression', variable_expr, ...
            'children', { ...
            } ...
        ), ...
        hdng.diagrams.FeatureDeclarator(...
            'identifier', 'variable_summary', ...
            'expression', variable_summary_expr, ...
            'children', { ...
                hdng.diagrams.features.LineDeclarator(...
                    'expression', variable_summary_line_expr ...
                ), ...
                hdng.diagrams.features.BoxDeclarator(...
                    'expression', variable_summary_box_expr ...
                ), ...
                hdng.diagrams.features.BoxDeclarator(...
                    'expression', variable_summary_rule_expr ...
                ) ...
            } ...
        ) ...
    );
    
    

    records = hdng.utilities.RecordTable.load_from_csv('/Users/work/Library/CloudStorage/OneDrive-UniversityCollegeLondon/Cognition and Pollution/Results/2024_07_23_03_43_53/2024_07_23_09_28_59/all_study_beta_data.csv');
    %records = hdng.utilities.RecordTable.load_from_csv('/Users/work/Library/CloudStorage/OneDrive-UniversityCollegeLondon/Cognition and Pollution/Results/vega-files/all_study_beta_data_test.csv');

    %test = records.pivot('study', {}, 'row_label', true);

    context = hdng.diagrams.Context(data_module, records, feature_module);
    
    tic;
    descriptor = context.compile();
    toc;

    tic;
    context.layout(descriptor);
    toc;
    
    tic;
    context.render(descriptor, renderer);
    toc;

end